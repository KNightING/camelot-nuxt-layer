# syntax=docker/dockerfile:1
#  前端（Nuxt 4，ssr: false）— 建置成靜態檔後交給 nginx 代管。
#
#   podman build -t spa-web:dev --build-arg APP_ENV=dev .
#   podman run -it -d -p 5173:80 --name spa-web-dev --replace spa-web:dev
#
# APP_ENV       要載入哪一份 .env.{APP_ENV}，決定 NUXT_PUBLIC_* 的值（見 .env.example）

ARG APP_ENV=dev
ARG NODE_VERSION=26-alpine
ARG NGINX_VERSION=1.31.4-alpine-slim

# ---- build ----
FROM node:${NODE_VERSION} AS build
ARG APP_ENV
ARG PNPM_VERSION=11.25.0
ENV PNPM_HOME="/pnpm"   PATH="/pnpm:$PATH"   CI=true
WORKDIR /src

# 與本機及 Dockerfile 使用相同的 pnpm 版本，讓 lockfile 的解析結果一致。
# 以 npm 安裝而非 corepack：corepack 自 Node 25 起不再隨官方映像發行。
RUN npm install -g pnpm@${PNPM_VERSION}

# 先只帶 lock 檔安裝，讓相依套件獨立成一層，改前端原始碼時不必重裝。
# --ignore-scripts：postinstall 的 nuxt prepare 此時還讀不到 nuxt.config，
# 而 generate 內部本來就會做 prepare，不必補跑。
# --trust-lockfile：跳過 pnpm 11 以 minimumReleaseAge 重新驗證每筆 lockfile 條目，
# 否則剛發布未滿 24 小時的相依套件會讓建置中止。
# .npmrc 與 pnpm-workspace.yaml 為必要檔案：前者設定 shamefully-hoist，缺少時
# `vue` 不在 node_modules/vue，Rollup 無法從 unplugin-icons 的虛擬模組解析；
# 後者承載 shamefullyHoist 與 allowBuilds。
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
RUN pnpm install --frozen-lockfile --ignore-scripts --trust-lockfile

COPY . .
RUN test -f ".env.${APP_ENV}" || { echo "缺少 .env.${APP_ENV}，請由 .env.example 複製一份"; exit 1; }
RUN pnpm run generate --dotenv ".env.${APP_ENV}"

# ---- runtime ----
FROM nginx:${NGINX_VERSION} AS runtime

# 讓基底套件套用 Alpine 最新安全修補，降低已知漏洞。
RUN apk upgrade --no-cache && rm -rf /var/cache/apk/*

COPY <<'EOF' /etc/nginx/conf.d/default.conf
server {
    listen      80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # public/templates/ 的空白範例檔是中文檔名，回應需明確標示 UTF-8
    charset utf-8;

    # 檔名帶 hash，可長期快取
    location /_nuxt/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # SPA：實體檔案優先，找不到一律回 index.html 交給前端路由
    # （/settings/users/{id} 這類動態路由沒有預先產生的 HTML）
    # HTML 不快取，否則改版後仍會載入舊的 entry chunk
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/index.html /index.html;
    }

    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_types      text/plain text/css application/javascript application/json image/svg+xml;
}
EOF

# 在 build 階段就驗證上面的設定語法
RUN nginx -t

COPY --from=build /src/.output/public /usr/share/nginx/html
EXPOSE 80
